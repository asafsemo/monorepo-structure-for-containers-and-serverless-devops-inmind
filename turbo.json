{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"exec-ui": {
			"persistent": true,
			"outputs": [],
			"dependsOn": ["build-ui"]
		},
		"exec-serverless": {
			"persistent": true,
			"outputs": [],
			"dependsOn": ["build-backend"]
		},
		"build-backend": {
			"dependsOn": ["^build-backend"],
			"outputs": ["dist/**"]
		},
		"build-ui": {
			"dependsOn": ["^build-ui"],
			"outputs": ["dist/**"]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"exec-dev": {
			"persistent": true,
			"dependsOn": ["build"]
		},
		"exec-api": {
			"dependsOn": ["^exec-api"]
		},
		"exec-unit": {
			"dependsOn": ["^exec-unit"]
		},
		"exec-coverage": {
			"dependsOn": ["^exec-coverage"]
		}
	}
}
