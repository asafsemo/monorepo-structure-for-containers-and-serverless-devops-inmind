```tsx
// ✅ CORRECT: Component with form handling
import { useForm } from 'react-hook-form'
import { getTranslation } from '#/lib/utils.ts'
import { zodResolver } from '@hookform/resolvers/zod'
import { z } from 'zod'
import { Button } from '@/components/ui/button'
import { Input } from '@/components/ui/input'
import type { Project } from '../types'

const projectSchema = z.object({
  name: z.string().min(1, 'Name is required'),
  description: z.string().min(10, 'Description must be at least 10 characters')
})

type ProjectFormData = z.infer<typeof projectSchema>

interface ProjectFormProps {
  initialData?: Partial<Project>
  onSubmit: (data: ProjectFormData) => void
  isSubmitting?: boolean
}

export const ProjectForm = (props: ProjectFormProps) => {
  const { initialData, onSubmit, isSubmitting = false } = props
  const t = getTranslation()
  
  const { register, handleSubmit, formState: { errors } } = useForm<ProjectFormData>({
    resolver: zodResolver(projectSchema),
    defaultValues: initialData
  })

  return (
    <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
      <div>
        <Input
          {...register('name')}
          placeholder={t('features.projects.form.namePlaceholder', 'Enter project name')}
          data-testid="project-name-input"
        />
        {errors.name && <p className="text-red-500">{errors.name.message}</p>}
      </div>
      
      <div>
        <Input
          {...register('description')}
          placeholder={t('features.projects.form.descriptionPlaceholder', 'Enter project description')}
          data-testid="project-description-input"
        />
        {errors.description && <p className="text-red-500">{errors.description.message}</p>}
      </div>
      
      <Button 
        type="submit" 
        disabled={isSubmitting}
        data-testid="submit-project-button"
      >
        {isSubmitting ? t('common.messages.loading', 'Loading...') : t('common.buttons.submit', 'Submit')}
      </Button>
    </form>
  )
}
```

### Containers Folder (`features/[feature-name]/containers/`)
**Purpose**: Feature entry points that handle business logic AND can include UI rendering

**Characteristics**:
- **"Smart" components** with business logic from `services.ts`
- **Can include direct UI rendering** when appropriate
- **Use Jotai atoms** for state management
- **Handle API calls** and complex business logic
- **Coordinate** between multiple components when needed

**Contains**:
- Business logic + API calls + state management
- Direct UI rendering (when not extracted to components)
- Composition of multiple reusable components
- User interaction handlers

