## Technology Stack & Architecture

### Core Technologies
- **React 19** with TypeScript
- **Vite** for build tooling
- **TanStack Router** for routing
- **TanStack Query** for server state management
- **Jotai** for client state management
- **Tailwind CSS** for styling and animations
- **Shadcn/ui** for UI components
- **React Hook Form** for form handling
- **Zod** for validation
- **Vitest** for unit testing
- **Playwright** for E2E testing
- **react-i18next** for internationalization

### Folder Structure
```
src/
├── routes/           # Page components with TanStack Router
├── components/
│   └── ui/          # Shadcn components
├── features/        # Feature-based modules
│   └── [feature-name]/
│       ├── components/  # "Dumb" components - UI only, props in/out
│       ├── containers/  # "Smart" components - business logic, API calls
│       ├── hooks.ts     # Business logic, API calls, and Jotai atoms
│       ├── types.ts     # TypeScript type definitions
│       └── index.ts     # Feature exports
├── locales/         # i18n translations (JSON)
├── utils/           # Utility functions
└── assets/          # Static assets (images, JS)
```

### Components vs Containers Architecture

#### Components Folder (`features/[feature-name]/components/`)
- **"Dumb" or presentational components**
- Focus solely on UI rendering
- Use local state Jotai atoms for UI state only
- **Cannot** communicate outside the component except through props
- Receive data via props, emit events via prop callbacks
- Can contain sub-components and sub-containers
- Should be highly reusable and testable

```tsx
// features/projects/components/project-card.tsx
import { useTranslation } from 'react-i18next'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card'
import type { Project } from '../types'

interface ProjectCardProps {
  project: Project
  onEdit?: (project: Project) => void
  onDelete?: (projectId: string) => void
}

export const ProjectCard = (props: ProjectCardProps) => {
  const { project, onEdit, onDelete } = props
  const { t } = useTranslation()

  return (
    <Card className="hover:shadow-lg transition-shadow">
      <CardHeader>
        <CardTitle>{project.name}</CardTitle>
      </CardHeader>
      <CardContent>
        <p className="text-gray-600 mb-4">{project.description}</p>
        <div className="flex gap-2">
          <Button 
            variant="outline" 
            onClick={() => onEdit?.(project)}
            data-testid="edit-project-button"
          >
            {t('common.buttons.edit')}
          </Button>
          <Button 
            variant="destructive" 
            onClick={() => onDelete?.(project.id)}
            data-testid="delete-project-button"
          >
            {t('common.buttons.delete')}
          </Button>
        </div>
      </CardContent>
    </Card>
  )
}
```

#### Containers Folder (`features/[feature-name]/containers/`)
- **"Smart" components with business logic**
- Handle data fetching, API calls, and complex state management
- Import and use functions/atoms from `hooks.ts`
- Can communicate with external services and other parts of the app
- Can contain sub-components and sub-containers
- Handle user interactions and business logic

```tsx
// features/projects/containers/projects-list-container.tsx
import { useTranslation } from 'react-i18next'
import { useAtomValue } from 'jotai'
import { ProjectCard } from '../components/project-card'
import { useProjectsDelete, useProjectsEdit, $projectsAtom, $loadingAtom } from '../hooks'
import type { Project } from '../types'

interface ProjectsListContainerProps {
  projects?: Project[]
  children?: React.ReactNode
}

export const ProjectsListContainer = (props: ProjectsListContainerProps) => {
  const { projects: externalProjects, children } = props
  const { t } = useTranslation()
  
  // Use external projects or fall back to atom state
  const atomProjects = useAtomValue($projectsAtom)
  const projects = externalProjects || atomProjects
  const loading = useAtomValue($loadingAtom)
  
  const { deleteProject } = useProjectsDelete()
  const { editProject } = useProjectsEdit()

  const handleEdit = (project: Project) => {
    editProject(project.id, project)
  }

  const handleDelete = async (projectId: string) => {
    await deleteProject(projectId)
  }

  if (loading) {
    return <div>{t('common.messages.loading')}</div>
  }

  return (
    <div className="space-y-4">
      {children}
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {projects.map(project => (
          <ProjectCard
            key={project.id}
            project={project}
            onEdit={handleEdit}
            onDelete={handleDelete}
          />
        ))}
      </div>
    </div>
  )
}
```

