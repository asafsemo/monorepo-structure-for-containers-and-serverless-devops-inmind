### Standard Atoms Pattern for Services

Each feature's services.ts should include these standard atoms:
```ts
// features/[feature-name]/services.ts
import { atom, useAtom, useSetAtom } from 'jotai'

// Atoms (keep these as regular atoms)
export const $loadingAtom = atom<boolean>(false)
export const $errorAtom = atom<string | null>(null)
export const $dataAtom = atom<DataType[]>([])

// API Functions (for route loaders)
export async function getData(): Promise<DataType[]> {
  // API implementation
}

// Custom hooks that use atoms
export const useDataLoad = () => {
  const setLoading = useSetAtom($loadingAtom)
  const setError = useSetAtom($errorAtom)
  const setData = useSetAtom($dataAtom)

  const loadData = async (): Promise<DataType[]> => {
    setLoading(true)
    setError(null)
    
    try {
      const data = await getData()
      setData(data)
      return data
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : 'Operation failed'
      setError(errorMessage)
      throw error
    } finally {
      setLoading(false)
    }
  }

  return { loadData, getData } // Expose both for different use cases
}
```

